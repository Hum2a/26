{
  // Isolated browser rehearsal only: no routes, account or remote credentials.
  "name": "26-browser-rehearsal",
  "main": "../../src/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "local",
    "ADMIN_EMAIL": "humzab1711@hotmail.com",
    "BETTER_AUTH_SECRET": "",
    "BETTER_AUTH_URL": "",
    "DATABASE_URL": "",
    "RESEND_API_KEY": "",
    "RESEND_FROM": "",
    "EMAIL_TEST_RECIPIENT": "",
    "R2_ACCOUNT_ID": "",
    "R2_ACCESS_KEY_ID": "",
    "R2_SECRET_ACCESS_KEY": "",
    "MEDIA_BUCKET_NAME": "26-browser-rehearsal",
    "CLIENT_API_KEY": "",
  },
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "26-browser-rehearsal" }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/ws", "/ws/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "PARTY_ROOM", "class_name": "PartyRoom" },
      { "name": "ROOM_CODE_REGISTRY", "class_name": "RoomCodeRegistry" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PartyRoom", "RoomCodeRegistry"] },
  ],
}
