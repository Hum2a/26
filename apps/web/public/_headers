# Only generated script, style and font extensions at this level. Unversioned
# audio and question pictures keep the default revalidation policy.
/assets/:file.js
  Cache-Control: public, max-age=31536000, immutable

/assets/:file.css
  Cache-Control: public, max-age=31536000, immutable

/assets/:file.woff2
  Cache-Control: public, max-age=31536000, immutable

/assets/:file.woff
  Cache-Control: public, max-age=31536000, immutable

# The standalone practice app has its own fingerprinted build outputs.
/kart-engine/assets/:file.js
  Cache-Control: public, max-age=31536000, immutable

/kart-engine/assets/:file.css
  Cache-Control: public, max-age=31536000, immutable

# Security headers for every page and asset. A full Content-Security-Policy is
# deliberately not set before the party: a wrong one silently breaks media.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  Strict-Transport-Security: max-age=31536000

# The admin console must never be framed by another site.
/admin*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
