# Tooling variables for builds and scripts.
# npm run env:sync creates one file per environment:
#   local:      .env.local
#   staging:    .env.staging
#   production: .env.production
# Existing values are preserved when you sync again.

# Set for staging or production builds. Leave blank for local development.
CLOUDFLARE_ENV=

# Same value as CLIENT_API_KEY in apps/api/.dev.vars. Rotate with npm run client-api-key:rotate.
VITE_CLIENT_API_KEY=
